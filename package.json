    "@pinia/colada-devtools": "^1.1.2",
    "@types/pg": "^8.23.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/devtools": "^0.5.0",
    "@vitejs/devtools-oxc": "^0.5.0",
    "@vitejs/devtools-rolldown": "^0.5.0",
    "@vitejs/devtools-vite": "^0.5.0",
    "@vitejs/devtools-vitest": "^0.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/ui": "^4.1.11",
    "@vue/tsconfig": "^0.9.1",
    "beasties": "^0.4.3",
    "db0": "^0.3.4",
    "kysely": "^0.29.5",
    "nitro": "latest",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-plugin-posva": "^0.0.2",
    "pg": "^8.23.0",
    "portless": "^0.15.5",
    "unhead": "^2.1.17",
    "vite": "latest",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.10"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.1",
    "@nuxt/ui": "^4.10.0",
    "@pinia/colada": "^1.4.2",
    "@unhead/vue": "^3.3.2",
    "@vueuse/core": "^14.4.0",
