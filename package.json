{
  "name": "starter-vue-ssr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "imports": {
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "build": "vite build",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "dev": "portless vue-nitro vite dev",
    "dev:inspect": "NITRO_DEV_RUNNER=node-process NODE_OPTIONS=--inspect=0 vite dev",
    "preview": "vite preview",
    "db:migrate": "node server/database/migrate-cli.ts",
    "test": "vitest run",
    "typecheck": "pnpm run '/^typecheck:.+$/'",
    "typecheck:app": "vue-tsc -p tsconfig.app.json",
    "typecheck:server": "tsgo -p tsconfig.server.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@iconify-json/lucide": "^1.2.124",
